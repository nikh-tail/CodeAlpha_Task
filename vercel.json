{
  "version": 2,
  "trailingSlash": true,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/gallery/:path*",
      "destination": "/task-1-image-gallery/:path*"
    },
    {
      "source": "/gallery",
      "destination": "/task-1-image-gallery/"
    },
    {
      "source": "/calculator/:path*",
      "destination": "/task-2-calculator/:path*"
    },
    {
      "source": "/calculator",
      "destination": "/task-2-calculator/"
    },
    {
      "source": "/portfolio/:path*",
      "destination": "/task-3-portfolio/:path*"
    },
    {
      "source": "/portfolio",
      "destination": "/task-3-portfolio/"
    },
    {
      "source": "/music/:path*",
      "destination": "/task-4-music-player/:path*"
    },
    {
      "source": "/music",
      "destination": "/task-4-music-player/"
    }
  ]
}
